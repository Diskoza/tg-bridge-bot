# Получите токен у @BotFather
BOT_TOKEN=123456789:ВСТАВЬТЕ_ТОКЕН

# Папки создаются рядом с ботом
DATA_DIR=./data
TEMP_DIR=./tmp
MODEL_DIR=./models

INVITE_TTL_MINUTES=30

# Защита от перегрузки
UPDATE_CONCURRENCY_LIMIT=24
MESSAGE_RATE_LIMIT=25
MESSAGE_RATE_WINDOW_SECONDS=10
JOIN_RATE_LIMIT=6
JOIN_RATE_WINDOW_SECONDS=600

# Распознавание русской речи
TRANSCRIPTION_ENABLED=true
WHISPER_MODEL=small
# auto сначала пробует NVIDIA CUDA, затем безопасно переходит на CPU
WHISPER_DEVICE=auto
WHISPER_LANGUAGE=ru
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
TRANSCRIPTION_WORKERS=1
TRANSCRIPTION_QUEUE_SIZE=6
TRANSCRIPTION_MAX_DURATION_SECONDS=300
TRANSCRIPTION_MAX_FILE_MB=18
TRANSCRIPT_MODE=summary

# Локальное сокращение через Ollama. При недоступности Ollama используется безопасный extractive fallback.
SUMMARY_BACKEND=extractive
SUMMARY_API_URL=http://127.0.0.1:11434/v1/chat/completions
SUMMARY_MODEL=qwen3:8b
SUMMARY_TIMEOUT_SECONDS=300
SUMMARY_MIN_WORDS=24
SUMMARY_TARGET_WORDS=85
SUMMARY_MAX_WORDS=130
SUMMARY_TEMPERATURE=0.0
